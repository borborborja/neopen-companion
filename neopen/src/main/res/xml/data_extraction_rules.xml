<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Excluye las credenciales (DataStore) del backup en la nube y de la
     transferencia entre dispositivos. Los cuadernos (Room) sí se respaldan. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/neopen-companion.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/neopen-companion.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
